{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.local.md",
    ".agents/rules/*.md"
  ],
  "permissions": [
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "refactor-bloated-code",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    }
  ]
}
